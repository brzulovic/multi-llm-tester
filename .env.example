# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Database Configuration
# Used by the frontend client to insert benchmark runs and results after each test:
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-api-key"
# Optional table prefix (default: llm_tester_). Avoids collisions with other projects (e.g. archon_*):
VITE_SUPABASE_TABLE_PREFIX="llm_tester_"

# Optional direct PostgreSQL connection string used by Makefile (make supabase-init) to execute schema DDL:
DATABASE_URL="postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres"
SUPABASE_DB_URL="postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres"
